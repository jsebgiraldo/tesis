/*
 * ESP32-C6 AMI Node — Device Tree Overlay
 * 
 * Configura:
 * - UART1 para RS-485 (medidor DLMS/Modbus)
 * - GPIO para RS-485 DE/RE control
 * - GPIO para tamper detection (alarma apertura caja)
 */

/ {
	aliases {
		meter-uart = &uart1;
		led0 = &led_status;
	};

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	leds {
		compatible = "gpio-leds";
		led_status: led_0 {
			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
			label = "Status LED";
		};
	};

	/* RS-485 direction control (DE/RE pin) */
	rs485_ctrl {
		compatible = "gpio-keys";
		rs485_de: rs485_de_pin {
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
			label = "RS485 DE/RE";
		};
	};

	/* Tamper detection switch */
	tamper_detect {
		compatible = "gpio-keys";
		tamper_sw: tamper_switch {
			gpios = <&gpio0 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Tamper Switch";
		};
	};
};

/* UART0: Console/Shell (default) */
&uart0 {
	status = "okay";
	current-speed = <115200>;
};

/* UART1: RS-485 to meter (DLMS/COSEM or Modbus RTU) */
&uart1 {
	status = "okay";
	current-speed = <9600>;
	/* TX: GPIO6, RX: GPIO7 — adjust per your wiring */
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
};

&ieee802154 {
	status = "okay";
};
