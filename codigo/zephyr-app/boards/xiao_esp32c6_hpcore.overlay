/*
 * XIAO ESP32-C6 AMI Node — Device Tree Overlay (Zephyr v4.2.0)
 *
 * Configura:
 * - UART1 para RS-485 (medidor DLMS/Modbus) — TX: GPIO0 (D0), RX: GPIO1 (D1)
 * - GPIO para RS-485 DE/RE control          — GPIO2 (D2)
 * - GPIO para tamper detection              — GPIO21 (D3)
 * - LED de estado ya definida en DTS base   — GPIO15
 *
 * Pin mapping XIAO ESP32-C6:
 *   D0=GPIO0, D1=GPIO1, D2=GPIO2, D3=GPIO21, D4=GPIO22(SDA),
 *   D5=GPIO23(SCL), D6=GPIO16(TX), D7=GPIO17(RX),
 *   D8=GPIO19(SCK), D9=GPIO20(MISO), D10=GPIO18(MOSI)
 *
 * La board base (xiao_esp32c6_hpcore) ya habilita:
 *   ieee802154, wifi, usb_serial (console), gpio0, trng0, wdt0
 */

#include <zephyr/dt-bindings/pinctrl/esp-pinctrl-common.h>
#include <dt-bindings/pinctrl/esp32c6-pinctrl.h>
#include <zephyr/dt-bindings/pinctrl/esp32c6-gpio-sigmap.h>

/* ── Pinctrl para UART1 (RS-485) ──────────────────────────── */
&pinctrl {
	uart1_default: uart1_default {
		group1 {
			pinmux = <UART1_TX_GPIO0>;
			output-high;
		};
		group2 {
			pinmux = <UART1_RX_GPIO1>;
			bias-pull-up;
		};
	};
};

/ {
	aliases {
		meter-uart = &uart1;
		/* led0 already defined in base DTS (GPIO15) */
	};

	/* RS-485 direction control (DE/RE pin) on D2 */
	rs485_ctrl {
		compatible = "gpio-keys";
		rs485_de: rs485_de_pin {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "RS485 DE/RE";
		};
	};

	/* Tamper detection switch on D3 */
	tamper_detect {
		compatible = "gpio-keys";
		tamper_sw: tamper_switch {
			gpios = <&gpio0 21 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Tamper Switch";
		};
	};
};

/* UART1: RS-485 to meter (DLMS/COSEM or Modbus RTU) */
&uart1 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
};
