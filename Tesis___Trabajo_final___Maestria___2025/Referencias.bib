  booktitle = {2025 {{IEEE}} 17th {{Malaysia International Conference}} on {{Communication}} ({{MICC}})},
  author = {Amril, Muhammad Firdaus and Abu-Samah, Asma and Abdullah, Nor Fadzilah},
  date = {2025-08-27},
  year = {2025},
  pages = {92--97},
  publisher = {IEEE},
