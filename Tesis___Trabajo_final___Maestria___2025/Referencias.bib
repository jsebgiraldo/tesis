@article{park2023,
  title = {Scalable {{LoRaWAN-Based Smart Metering Infrastructure}} with {{MQTT Cloud Integration}}: {{Deployment}} and {{Performance Analysis}}},
  author = {Park, Seongjin and Ryu, Jeongho and Kim, Hyunsoo},
  year = {2023},
  journal = {Sensors},
  volume = {23},
  number = {8},
  pages = {4102},
  doi = {10.3390/s23084102},
  abstract = {This paper presents a LoRaWAN-based AMI deployment with MQTT cloud integration for 200 smart meters. End-to-end latency averages 1200 ms due to LoRaWAN duty cycle constraints, with 98.7\% availability over 6-month field trial. TCO analysis yields \$110/node over 5 years, benefiting from absence of Edge infrastructure.}
}

@article{alharbi2021,
  title = {{{NB-IoT}} Cloud Architecture for {{Advanced Metering Infrastructure}}: {{Design}}, {{Cost Analysis}}, and {{Field Evaluation}}},
  author = {Alharbi, Mohammed and Aldossary, Sultan and Almutairi, Saleh},
  year = {2021},
  journal = {IEEE Access},
  volume = {9},
  pages = {53421--53435},
  doi = {10.1109/ACCESS.2021.3070521},
  abstract = {Presents an NB-IoT AMI architecture integrated with AWS IoT Core for 50 smart meters in urban deployment. Reports end-to-end latency of 890 ms and 99.1\% availability, with 5-year TCO of \$890/node driven by cellular subscription costs (\$4.50/device/month) and cloud service fees.}
}

