  abstract = {Apache Kafka is a distributed streaming platform designed for high-throughput, fault-tolerant, real-time data pipelines. This paper analyzes Kafka's architecture including partitioned, replicated commit logs, consumer groups, and exactly-once semantics. Benchmarks demonstrate 2M+ messages/second on 3-broker clusters with sub-10ms latency for IoT telemetry workloads.},
  keywords = {Apache Kafka, streaming, IoT, performance, throughput, distributed systems}
}

@article{freedmanTimescaleDBSQLMade2024,
  title = {{TimescaleDB}: {SQL} Made Scalable for Time-Series Data},
  author = {Freedman, Michael J. and Kulkarni, Ajay},
  year = {2024},
  journaltitle = {Proceedings of the VLDB Endowment},
  journal = {Proceedings of the VLDB Endowment},
  volume = {17},
  number = {4},
  pages = {921--936},
  doi = {10.14778/3636218.3636230},
  abstract = {TimescaleDB is an open-source relational database for time-series data built on PostgreSQL. It provides automatic partitioning (hypertables with configurable chunk intervals), native compression (10:1 ratio for columnar time-series), continuous aggregates for pre-computed materialized views, and full SQL compatibility. Benchmarks show 10-100x query speedup versus vanilla PostgreSQL for time-range analytical queries on IoT telemetry data.},
  keywords = {TimescaleDB, time-series, PostgreSQL, hypertable, compression, IoT, database}
}

